# Secreto para firmar las sesiones del panel. OBLIGATORIO en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Claves iniciales. Se piden cambiar en el primer ingreso.
# Si las dejas vacías, el servidor genera una al azar y la imprime en el log de arranque.
ADMIN_INITIAL_PASSWORD=
TEACHER_INITIAL_PASSWORD=

# Firebase (opcional). Sin esto la app guarda todo en local_data.json.
# Pega aquí el JSON de configuración en una sola línea, o usa FIREBASE_CONFIG_PATH.
FIREBASE_CONFIG=
FIREBASE_CONFIG_PATH=
