    "test:iconos": "node tests/e2e-iconos.mjs",
    "test:datos": "node tests/e2e-datos.mjs",
    "test:modulos": "node tests/e2e-camino-feliz.mjs",
    "test:intentos": "node tests/e2e-intentos.mjs",
    "test:atascos": "node tests/e2e-atascos.mjs",
    "test:ranking": "node tests/e2e-ranking.mjs",
    "test:movil": "node tests/e2e-movil.mjs",
    "test:guion": "node tests/e2e-guion.mjs",
    "test:deshacer": "node tests/e2e-deshacer.mjs",
    "test:proceso": "node tests/e2e-proceso.mjs",
    "test:errores": "node tests/e2e-errores.mjs",
    "test:repetir": "node tests/e2e-repetir.mjs"
